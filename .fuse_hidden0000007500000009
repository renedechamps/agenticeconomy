                Enter your <strong>Google Gemini API key</strong> to enable the chatbot. Your key will be saved locally in your browser.
            </div>
            <input type="password" class="setup-input" id="apiKeyInput" placeholder="Paste your Gemini API key here">
            <button class="setup-button" id="saveKeyBtn">Save & Start Chatting</button>
            <div class="setup-note">
                Get a free API key from <a href="https://aistudio.google.com/app/apikey" target="_blank" style="color: var(--accent);">Google AI Studio</a>
            </div>
        </div>
    </div>

    <script>
        // System prompt for the chatbot
        const SYSTEM_PROMPT = `You are the Agentic Economy Research Assistant, powered by agenticeconomy.dev. You answer questions ONLY about the agentic economy based on the research corpus below. If a question is outside this scope, politely redirect to the topic.

KNOWLEDGE BASE:
- The agentic economy refers to economic activity where AI agents autonomously transact, negotiate, and make decisions on behalf of humans or organizations.
- There are 51 published definitions spanning 2021-2026, organized in 6 categories:
  A: Agent-Assisted Commerce (14 definitions) - Human-initiated, agent-executed transactions (Visa, Mastercard, Stripe, PayPal, Amazon)
  B: Agent-as-Workforce (8) - Agents replacing human labor functions (Salesforce, Microsoft, Google)
  C_cr: Agent-to-Agent Blockchain (11) - Crypto-native autonomous agent economies (Fetch.ai, Olas, Circle)
  C_s: Agent-to-Agent Non-Crypto (1) - Traditional settlement for agent transactions (BotNode)
  D: Analytical/Regulatory (7) - Policy and oversight frameworks (Gartner, McKinsey, EU)
  E: Infrastructure/Standards (10) - Protocols enabling agent commerce (Google A2A, Anthropic MCP, x402, IEEE)

- 3 research papers by René Dechamps Otamendi on Zenodo:
  1. CRI paper (DOI: 10.5281/zenodo.19208083) - Commerce Readiness Index
  2. Taxonomy paper (zenodo.org/records/19208278) - 51 definitions taxonomy
  3. Oracle Problem paper (zenodo.org/records/19208440) - Trust in agent transactions

- Settlement Neutrality: Framework with 5 properties - Escrow Determinism, Ledger Consistency, Reputation Equivalence, Dispute Parity, Auditability

- Key protocols: Google A2A, Anthropic MCP, x402 (119M+ transactions), Olas (700K monthly tx), Mastercard Agent Pay, Visa Intelligent Commerce, Stripe ACP, Circle USDC, IEEE 7012, IETF VCAP

- Market size: $7B current → $93B by 2032 (CAGR ~40%)
- McKinsey estimates $3-5T in agent-mediated commerce by 2030
- The "11:1 ratio": 11 definitions describe agent-to-agent commerce vs 1 (BotNode) that proposes traditional settlement

Keep responses concise (2-4 paragraphs max). Use specific data points. Link to relevant pages when appropriate:
- Definitions: agentic-economy-definitions.html
- Timeline: agentic-economy-timeline.html
- Protocols: agentic-economy-protocols.html
- 101 Guide: agentic-economy-101.html
- Glossary: agentic-economy-glossary.html
- Papers: agentic-economy-research.html`;

        // DOM elements
        const chatMessages = document.getElementById('chatMessages');
        const chatInput = document.getElementById('chatInput');
        const sendBtn = document.getElementById('sendBtn');
        const settingsBtn = document.getElementById('settingsBtn');
        const setupOverlay = document.getElementById('setupOverlay');
        const apiKeyInput = document.getElementById('apiKeyInput');
        const saveKeyBtn = document.getElementById('saveKeyBtn');
        const navToggle = document.querySelector('.nav-toggle');
        const navMenu = document.querySelector('.nav-menu');

        // State
        let conversationHistory = [];
        let isLoading = false;

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            const hasApiKey = localStorage.getItem('gemini_api_key');
            if (!hasApiKey) {
                setupOverlay.style.display = 'flex';
                chatInput.disabled = true;
                sendBtn.disabled = true;
            } else {
                addWelcomeMessage();
            }

            // Event listeners
            sendBtn.addEventListener('click', sendMessage);
            chatInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            settingsBtn.addEventListener('click', () => {
                setupOverlay.style.display = 'flex';
                apiKeyInput.value = localStorage.getItem('gemini_api_key') || '';
            });

            saveKeyBtn.addEventListener('click', saveApiKey);

            // Suggested questions
            document.querySelectorAll('.question-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    chatInput.value = btn.dataset.question;
                    chatInput.focus();
                    sendMessage();
                });
            });

            // Mobile nav toggle
            navToggle.addEventListener('click', () => {
                navMenu.classList.toggle('active');
            });

            // Close nav when clicking a link
            document.querySelectorAll('.nav-item, .dropdown-panel a').forEach(link => {
                link.addEventListener('click', () => {
                    navMenu.classList.remove('active');
                });
            });

            // Dropdown toggle on mobile
            document.querySelectorAll('.nav-dropdown-trigger').forEach(trigger => {
                trigger.addEventListener('click', (e) => {
                    if (window.innerWidth <= 768) {
                        e.preventDefault();
                        trigger.parentElement.classList.toggle('active');
                    }
                });
            });
        });

        function saveApiKey() {
            const key = apiKeyInput.value.trim();
            if (!key) {
                alert('Please enter your Gemini API key');
                return;
            }
            localStorage.setItem('gemini_api_key', key);
            setupOverlay.style.display = 'none';
            chatInput.disabled = false;
            sendBtn.disabled = false;
            chatInput.focus();
            if (chatMessages.children.length === 0) {
                addWelcomeMessage();
            }
        }

        function addWelcomeMessage() {
            const welcomeMsg = `Welcome to the Agentic Economy Research Assistant! I can answer questions about:

• The 51 definitions of the agentic economy
• Protocols and standards (x402, MCP, Google A2A, etc.)
• Settlement neutrality and its properties
• Market size and growth projections
• Companies and projects in the space
• Regulatory frameworks
• Research papers and detailed data

Try asking me anything about the agentic economy. You can click the suggested questions on the left, or type your own question below.`;

            chatMessages.innerHTML = '';
            addMessage(welcomeMsg, 'bot', true);
        }

        function addMessage(text, sender, isWelcome = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${sender}`;

            if (!isWelcome) {
                const avatar = document.createElement('div');
                avatar.className = 'message-avatar';
                avatar.textContent = sender === 'bot' ? 'AE' : '';
                if (sender === 'bot') {
                    messageDiv.appendChild(avatar);
                }
            }

            const content = document.createElement('div');
            content.className = 'message-content';
            if (isWelcome) {
                content.className += ' welcome-message';
            }
            content.innerHTML = renderMarkdown(text);
            messageDiv.appendChild(content);

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function addTypingIndicator() {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message bot';
            messageDiv.id = 'typingIndicator';

            const avatar = document.createElement('div');
            avatar.className = 'message-avatar';
            avatar.textContent = 'AE';
            messageDiv.appendChild(avatar);

            const typing = document.createElement('div');
            typing.className = 'typing-indicator';
            typing.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';
            messageDiv.appendChild(typing);

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typingIndicator');
            if (indicator) {
                indicator.remove();
            }
        }

        function renderMarkdown(text) {
            // Escape HTML
            text = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            // Convert markdown to HTML
            // Bold
            text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            text = text.replace(/__(.*?)__/g, '<strong>$1</strong>');

            // Italic
            text = text.replace(/\*(.*?)\*/g, '<em>$1</em>');
            text = text.replace(/_(.*?)_/g, '<em>$1</em>');

            // Links [text](url)
            text = text.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank">$1</a>');

            // Code blocks
            text = text.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');

            // Inline code
            text = text.replace(/`(.*?)`/g, '<code>$1</code>');

            // Lists
            text = text.replace(/^\* (.*?)$/gm, '<li>$1</li>');
            text = text.replace(/^\d+\. (.*?)$/gm, '<li>$1</li>');
            text = text.replace(/(<li>.*?<\/li>)/s, '<ul>$1</ul>');
            text = text.replace(/<\/li>\n<li>/g, '</li>\n<li>');

            // Line breaks
            text = text.replace(/\n\n/g, '</p><p>');
            text = '<p>' + text + '</p>';

            return text;
        }

        async function sendMessage() {
            const message = chatInput.value.trim();
            if (!message || isLoading) return;

            // Add user message
            addMessage(message, 'user');
            conversationHistory.push({ role: 'user', parts: [{ text: message }] });

            // Clear input
            chatInput.value = '';
            chatInput.style.height = 'auto';

            // Show typing indicator
            addTypingIndicator();
            isLoading = true;
            sendBtn.disabled = true;

            try {
                const response = await callGeminiAPI(message);
                removeTypingIndicator();
                addMessage(response, 'bot');
                conversationHistory.push({ role: 'model', parts: [{ text: response }] });
            } catch (error) {
                removeTypingIndicator();
                addMessage(`Sorry, I encountered an error: ${error.message}. Please try again or check your API key.`, 'bot');
            } finally {
                isLoading = false;
                sendBtn.disabled = false;
                chatInput.focus();
            }
        }

        async function callGeminiAPI(userMessage) {
            const apiKey = localStorage.getItem('gemini_api_key');
            if (!apiKey) {
                throw new Error('API key not configured');
            }

            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`;

            // Build request with conversation context
            const messages = [
                {
                    role: 'user',
                    parts: [{ text: SYSTEM_PROMPT }]
                }
            ];

            // Add conversation history
            messages.push(...conversationHistory);

            // Add current message
            messages.push({
                role: 'user',
                parts: [{ text: userMessage }]
            });

            const requestBody = {
                contents: messages,
                generationConfig: {
                    temperature: 0.3,
                    maxOutputTokens: 1024
                }
            };

            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestBody)
            });

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error?.message || `API error: ${response.status}`);
            }

            const data = await response.json();
            if (!data.candidates || !data.candidates[0] || !data.candidates[0].content) {
                throw new Error('Invalid API response');
            }

            return data.candidates[0].content.parts[0].text;
        }

        // Auto-expand textarea
        chatInput.addEventListener('input', () => {
            chatInput.style.height = 'auto';
            chatInput.style.height = Math.min(chatInput.scrollHeight, 100) + 'px';
        });
    </script>
</body>
