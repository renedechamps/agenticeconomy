<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>51 Definitions of the Agentic Economy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Outfit:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg-deep:#04060e;--bg-base:#080d1c;--bg-surface:#0f1530;
  --bg-card:#141a38;--border:#1a2348;
  --text-primary:#e8ecf4;--text-secondary:#a0a9c0;--text-muted:#6b7394;
  --accent:#34d399;--warm:#f59e0b;
  --font-display:'Syne',sans-serif;
  --font-body:'Outfit',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
  --cat-a:#3b82f6;--cat-a-glow:rgba(59,130,246,.15);
  --cat-b:#a78bfa;--cat-b-glow:rgba(167,139,250,.15);
  --cat-ccr:#f59e0b;--cat-ccr-glow:rgba(245,158,11,.15);
  --cat-cs:#34d399;--cat-cs-glow:rgba(52,211,153,.15);
  --cat-d:#f87171;--cat-d-glow:rgba(248,113,113,.15);
  --cat-e:#22d3ee;--cat-e-glow:rgba(34,211,238,.15);
}
html{scroll-behavior:smooth}
/* ── Site Navigation ── */
.site-nav{position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(4,6,14,.97);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--border);height:56px;display:flex;align-items:center;padding:0 2rem}
.nav-container{max-width:1200px;margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between}
.nav-brand{font-family:'Syne',sans-serif;font-weight:700;font-size:1.05rem;color:var(--accent);text-decoration:none;letter-spacing:-.02em}
.nav-menu{display:flex;align-items:center;gap:.25rem}
.nav-item{color:var(--text-secondary);text-decoration:none;font-family:'Outfit',sans-serif;font-size:.88rem;padding:.45rem .75rem;border-radius:6px;transition:color .2s,background .2s;border:none;background:none;cursor:pointer;white-space:nowrap}
.nav-item:hover,.nav-item.active{color:var(--text-primary);background:var(--bg-surface)}
.nav-dropdown{position:relative}
.nav-dropdown-trigger{display:flex;align-items:center;gap:.3rem}
.arrow{font-size:.6rem;transition:transform .2s}
.nav-dropdown:hover .arrow{transform:rotate(180deg)}
.dropdown-panel{display:none;position:absolute;top:calc(100% + 4px);left:0;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:.4rem 0;min-width:180px;box-shadow:0 12px 40px rgba(0,0,0,.5)}
.nav-dropdown:hover .dropdown-panel{display:block}
.dropdown-panel a{display:block;padding:.5rem 1rem;color:var(--text-secondary);text-decoration:none;font-family:'Outfit',sans-serif;font-size:.85rem;transition:color .15s,background .15s,padding-left .15s}
.dropdown-panel a:hover{color:var(--accent);background:var(--bg-surface);padding-left:1.25rem}
.nav-toggle{display:none;background:none;border:none;color:var(--text-primary);font-size:1.4rem;cursor:pointer;padding:.5rem}
@media(max-width:768px){
  .nav-toggle{display:block}
  .nav-menu{display:none;position:absolute;top:56px;left:0;right:0;background:var(--bg-card);border-bottom:1px solid var(--border);flex-direction:column;padding:1rem;gap:.15rem}
  .nav-menu.open{display:flex}
  .dropdown-panel{position:static;box-shadow:none;border:none;background:var(--bg-surface);border-radius:6px;margin:.25rem 0 .25rem 1rem;display:none}
  .nav-dropdown.open .dropdown-panel{display:block}
}

body{
  background:var(--bg-deep);color:var(--text-primary);
  font-family:var(--font-body);line-height:1.6;
  min-height:100vh;-webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  padding-top:56px;
}

/* ══ Animated background particles ══ */
.bg-particles{
  position:fixed;inset:0;pointer-events:none;z-index:0;
  overflow:hidden;
}
.bg-particles span{
  position:absolute;border-radius:50%;
  animation:float linear infinite;
  opacity:0;
}
@keyframes float{
  0%{transform:translateY(100vh) scale(0);opacity:0}
  10%{opacity:1}
  90%{opacity:1}
  100%{transform:translateY(-10vh) scale(1);opacity:0}
}

/* ══ Hero ══ */
.hero{
  position:relative;z-index:1;
  padding:7rem 2rem 4.5rem;text-align:center;
  background:
    radial-gradient(ellipse at 30% 20%,rgba(59,130,246,.04) 0%,transparent 50%),
    radial-gradient(ellipse at 70% 30%,rgba(52,211,153,.05) 0%,transparent 50%),
    radial-gradient(ellipse at 50% 80%,rgba(245,158,11,.03) 0%,transparent 50%);
}
.hero .count-wrapper{
  position:relative;display:inline-block;margin-bottom:.5rem;
}
.hero .count{
  font-family:var(--font-mono);font-weight:500;
  font-size:clamp(4rem,12vw,8rem);
  background:linear-gradient(135deg,var(--accent),var(--warm));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  letter-spacing:-.06em;line-height:1;
  filter:drop-shadow(0 0 40px rgba(52,211,153,.2));
}
.hero .count-label{
  font-family:var(--font-mono);font-size:.85rem;
  color:var(--text-muted);letter-spacing:.15em;text-transform:uppercase;
  display:block;margin-top:.25rem;
}
.hero h1{
  font-family:var(--font-display);font-weight:800;
  font-size:clamp(1.8rem,4vw,3.2rem);
  line-height:1.15;margin-bottom:1rem;
  color:var(--text-primary);
}
.hero h1 em{
  font-style:normal;
  background:linear-gradient(135deg,var(--accent),#60a5fa);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.hero .subtitle{
  max-width:600px;margin:0 auto;font-size:1.05rem;
  color:var(--text-secondary);line-height:1.7;
}
.hero .meta-line{
  margin-top:1.5rem;
  display:flex;flex-wrap:wrap;justify-content:center;gap:1.5rem;
  font-family:var(--font-mono);font-size:.75rem;color:var(--text-muted);
}
.hero .meta-line span{display:flex;align-items:center;gap:.4rem}
.hero::after{
  content:'';position:absolute;bottom:0;left:5%;right:5%;height:1px;
  background:linear-gradient(90deg,transparent,var(--border),transparent);
}

/* ══ Distribution Bar ══ */
.distro-bar-section{
  position:relative;z-index:1;
  max-width:900px;margin:2.5rem auto 0;padding:0 2rem;
}
.distro-bar{
  display:flex;height:8px;border-radius:4px;overflow:hidden;
  background:var(--bg-surface);
}
.distro-bar .seg{transition:all .6s cubic-bezier(.4,0,.2,1);cursor:pointer;position:relative}
.distro-bar .seg:hover{filter:brightness(1.3)}
.distro-labels{
  display:flex;justify-content:center;flex-wrap:wrap;gap:.4rem .8rem;
  margin-top:.75rem;
}
.distro-labels .dl{
  display:flex;align-items:center;gap:.3rem;
  font-size:.72rem;font-family:var(--font-mono);color:var(--text-muted);
  cursor:pointer;transition:color .2s;
}
.distro-labels .dl:hover{color:var(--text-primary)}
.distro-labels .dl .swatch{width:8px;height:8px;border-radius:2px;flex-shrink:0}

/* ══ Controls ══ */
.controls{
  position:sticky;top:0;z-index:100;
  background:rgba(4,6,14,.85);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  padding:1rem 2rem;
  transition:box-shadow .3s;
}
.controls.scrolled{box-shadow:0 4px 24px rgba(0,0,0,.4)}
.controls-inner{
  max-width:1320px;margin:0 auto;
  display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;
}
.search-box{flex:1 1 240px;position:relative}
.search-box input{
  width:100%;padding:.65rem 1rem .65rem 2.5rem;
  background:var(--bg-surface);border:1px solid var(--border);
  border-radius:10px;color:var(--text-primary);
  font-family:var(--font-body);font-size:.9rem;
  outline:none;transition:all .3s;
}
.search-box input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(52,211,153,.1)}
.search-box input::placeholder{color:var(--text-muted)}
.search-box svg{position:absolute;left:.75rem;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--text-muted);pointer-events:none}
.filter-pills{display:flex;flex-wrap:wrap;gap:.4rem}
.pill{
  padding:.4rem .75rem;border-radius:8px;
  border:1px solid var(--border);background:transparent;
  color:var(--text-muted);font-size:.78rem;font-weight:500;
  cursor:pointer;transition:all .25s;font-family:var(--font-mono);
  display:flex;align-items:center;gap:.35rem;
  position:relative;overflow:hidden;
}
.pill::before{
  content:'';position:absolute;inset:0;opacity:0;transition:opacity .25s;
  border-radius:inherit;
}
.pill:hover{color:var(--text-secondary);border-color:var(--text-muted)}
.pill.active{color:#fff;border-color:transparent}
.pill[data-cat="all"].active{background:var(--bg-card);color:var(--text-primary);border-color:var(--text-muted)}
.pill[data-cat="A"].active{background:var(--cat-a);box-shadow:0 0 16px var(--cat-a-glow)}
.pill[data-cat="B"].active{background:var(--cat-b);box-shadow:0 0 16px var(--cat-b-glow)}
.pill[data-cat="Ccr"].active{background:var(--cat-ccr);color:#000;box-shadow:0 0 16px var(--cat-ccr-glow)}
.pill[data-cat="Cs"].active{background:var(--cat-cs);color:#000;box-shadow:0 0 16px var(--cat-cs-glow)}
.pill[data-cat="D"].active{background:var(--cat-d);box-shadow:0 0 16px var(--cat-d-glow)}
.pill[data-cat="E"].active{background:var(--cat-e);color:#000;box-shadow:0 0 16px var(--cat-e-glow)}
.pill .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.pill[data-cat="A"] .dot{background:var(--cat-a)}
.pill[data-cat="B"] .dot{background:var(--cat-b)}
.pill[data-cat="Ccr"] .dot{background:var(--cat-ccr)}
.pill[data-cat="Cs"] .dot{background:var(--cat-cs)}
.pill[data-cat="D"] .dot{background:var(--cat-d)}
.pill[data-cat="E"] .dot{background:var(--cat-e)}
.pill.active .dot{background:#fff}
.pill[data-cat="Ccr"].active .dot,.pill[data-cat="Cs"].active .dot,.pill[data-cat="E"].active .dot{background:#000}

.result-count{
  font-family:var(--font-mono);font-size:.75rem;color:var(--text-muted);
  margin-left:auto;white-space:nowrap;
}

/* ══ Grid ══ */
.grid-container{
  position:relative;z-index:1;
  max-width:1320px;margin:0 auto;padding:2rem 2rem 4rem;
}
.category-section{
  margin-bottom:3.5rem;
  animation:sectionIn .5s ease both;
}
@keyframes sectionIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.category-header{
  display:flex;align-items:center;gap:.6rem;
  margin-bottom:.4rem;
}
.cat-line{
  font-family:var(--font-mono);font-size:.7rem;font-weight:500;
  padding:.2rem .5rem;border-radius:5px;color:#fff;
  display:inline-flex;align-items:center;
}
.category-header h2{
  font-family:var(--font-display);font-weight:700;font-size:1.25rem;
}
.category-header .cat-count{
  font-family:var(--font-mono);font-size:.72rem;color:var(--text-muted);
  margin-left:auto;
}
.category-narrative{
  font-size:.85rem;color:var(--text-muted);line-height:1.65;
  max-width:720px;margin-bottom:1rem;
}

/* ══ Cards ══ */
.cards-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(260px,1fr));
  gap:.65rem;
}
.card{
  background:var(--bg-card);
  border:1px solid var(--border);
  border-radius:12px;
  padding:1rem 1.1rem .9rem;
  cursor:pointer;
  transition:all .3s cubic-bezier(.4,0,.2,1);
  position:relative;overflow:hidden;
  animation:cardIn .4s ease both;
}
@keyframes cardIn{from{opacity:0;transform:scale(.96) translateY(8px)}to{opacity:1;transform:none}}
.card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  transition:height .3s;
}
.card::after{
  content:'';position:absolute;inset:0;
  border-radius:inherit;opacity:0;transition:opacity .3s;
  pointer-events:none;
}
.card:hover{
  transform:translateY(-3px);
  border-color:rgba(255,255,255,.12);
}
.card:hover::before{height:3px}
.card:hover::after{opacity:1}

/* Category-specific card glow */
.card[data-cat="A"]::before{background:var(--cat-a)}
.card[data-cat="A"]::after{box-shadow:inset 0 0 30px var(--cat-a-glow)}
.card[data-cat="B"]::before{background:var(--cat-b)}
.card[data-cat="B"]::after{box-shadow:inset 0 0 30px var(--cat-b-glow)}
.card[data-cat="Ccr"]::before{background:var(--cat-ccr)}
.card[data-cat="Ccr"]::after{box-shadow:inset 0 0 30px var(--cat-ccr-glow)}
.card[data-cat="Cs"]::before{background:var(--cat-cs)}
.card[data-cat="Cs"]::after{box-shadow:inset 0 0 30px var(--cat-cs-glow)}
.card[data-cat="D"]::before{background:var(--cat-d)}
.card[data-cat="D"]::after{box-shadow:inset 0 0 30px var(--cat-d-glow)}
.card[data-cat="E"]::before{background:var(--cat-e)}
.card[data-cat="E"]::after{box-shadow:inset 0 0 30px var(--cat-e-glow)}

.card .c-top{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:.35rem;
}
.card .c-id{
  font-family:var(--font-mono);font-size:.7rem;font-weight:500;
  padding:.15rem .4rem;border-radius:4px;
  background:rgba(255,255,255,.05);color:var(--text-muted);
}
.card .c-date{font-family:var(--font-mono);font-size:.65rem;color:var(--text-muted)}
.card .c-source{
  font-family:var(--font-display);font-weight:700;
  font-size:.95rem;line-height:1.25;margin-bottom:.15rem;
  color:var(--text-primary);
}
.card .c-sub{
  font-size:.78rem;color:var(--text-secondary);margin-bottom:.4rem;
  font-weight:400;
}
.card .c-def{
  font-size:.78rem;color:var(--text-muted);line-height:1.5;
  font-style:italic;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.card .c-expand{
  display:flex;align-items:center;gap:.3rem;
  margin-top:.5rem;font-family:var(--font-mono);
  font-size:.65rem;color:var(--text-muted);
  opacity:0;transition:opacity .3s;
}
.card:hover .c-expand{opacity:1}

/* ══ Modal ══ */
.modal-overlay{
  position:fixed;inset:0;z-index:1000;
  display:flex;align-items:center;justify-content:center;
  padding:2rem;
  background:rgba(4,6,14,0);
  backdrop-filter:blur(0px);
  pointer-events:none;
  transition:all .35s cubic-bezier(.4,0,.2,1);
}
.modal-overlay.open{
  background:rgba(4,6,14,.88);
  backdrop-filter:blur(12px);
  pointer-events:all;
}
.modal{
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:16px;
  max-width:660px;width:100%;
  max-height:85vh;overflow-y:auto;
  padding:2.25rem;position:relative;
  transform:translateY(24px) scale(.97);
  opacity:0;
  transition:all .35s cubic-bezier(.4,0,.2,1);
}
.modal-overlay.open .modal{
  transform:none;opacity:1;
}
.modal::-webkit-scrollbar{width:6px}
.modal::-webkit-scrollbar-track{background:transparent}
.modal::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
.modal-close{
  position:absolute;top:1rem;right:1rem;
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:8px;width:34px;height:34px;
  color:var(--text-secondary);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  font-size:1.1rem;transition:all .2s;
}
.modal-close:hover{color:var(--text-primary);border-color:var(--accent);background:rgba(52,211,153,.08)}
.m-badge{
  font-family:var(--font-mono);font-size:.7rem;font-weight:500;
  padding:.2rem .55rem;border-radius:5px;color:#fff;display:inline-block;
  margin-bottom:.75rem;
}
.m-id{font-family:var(--font-mono);font-size:.8rem;color:var(--text-muted);margin-bottom:.2rem}
.m-source{font-family:var(--font-display);font-weight:800;font-size:1.6rem;line-height:1.2;margin-bottom:.2rem}
.m-sub{font-size:.95rem;color:var(--text-secondary);margin-bottom:.5rem}
.m-date{font-family:var(--font-mono);font-size:.78rem;color:var(--text-muted);margin-bottom:1.25rem;display:flex;align-items:center;gap:.4rem}
.m-date::before{content:'';width:12px;height:1px;background:var(--text-muted)}
.m-definition{
  font-size:1.05rem;line-height:1.65;
  padding:1.1rem 1.3rem;margin-bottom:1.25rem;
  border-radius:10px;position:relative;
}
.m-definition::before{
  content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  border-radius:3px;
}
.m-notes{font-size:.88rem;color:var(--text-secondary);line-height:1.7;margin-bottom:1rem}
.m-tags{display:flex;flex-wrap:wrap;gap:.35rem}
.m-tags span{
  font-family:var(--font-mono);font-size:.68rem;
  padding:.18rem .5rem;border-radius:5px;
  background:var(--bg-card);color:var(--text-muted);
  border:1px solid var(--border);transition:all .2s;
}
.m-tags span:hover{border-color:var(--text-muted);color:var(--text-secondary)}

/* Category-specific modal definition styling */
.m-definition.cat-A{background:var(--cat-a-glow);color:#93bbfd}
.m-definition.cat-A::before{background:var(--cat-a)}
.m-definition.cat-B{background:var(--cat-b-glow);color:#c4b5fd}
.m-definition.cat-B::before{background:var(--cat-b)}
.m-definition.cat-Ccr{background:var(--cat-ccr-glow);color:#fcd34d}
.m-definition.cat-Ccr::before{background:var(--cat-ccr)}
.m-definition.cat-Cs{background:var(--cat-cs-glow);color:#6ee7b7}
.m-definition.cat-Cs::before{background:var(--cat-cs)}
.m-definition.cat-D{background:var(--cat-d-glow);color:#fca5a5}
.m-definition.cat-D::before{background:var(--cat-d)}
.m-definition.cat-E{background:var(--cat-e-glow);color:#67e8f9}
.m-definition.cat-E::before{background:var(--cat-e)}

/* ══ Nav arrows in modal ══ */
.m-nav{
  display:flex;justify-content:space-between;
  margin-top:1.5rem;padding-top:1rem;
  border-top:1px solid var(--border);
}
.m-nav button{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:8px;padding:.4rem .8rem;
  color:var(--text-secondary);cursor:pointer;
  font-family:var(--font-mono);font-size:.75rem;
  display:flex;align-items:center;gap:.35rem;
  transition:all .2s;
}
.m-nav button:hover{border-color:var(--accent);color:var(--accent)}
.m-nav button:disabled{opacity:.3;cursor:default;border-color:var(--border);color:var(--text-muted)}

/* ══ Stats section ══ */
.stats-section{
  position:relative;z-index:1;
  max-width:1320px;margin:3rem auto 0;padding:0 2rem;
}
.stats-section h2{
  font-family:var(--font-display);font-weight:700;
  font-size:1.15rem;margin-bottom:1rem;
}
.stats-grid{
  display:grid;grid-template-columns:repeat(6,1fr);gap:.6rem;
}
@media(max-width:900px){.stats-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:500px){.stats-grid{grid-template-columns:repeat(2,1fr)}}
.stat{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:12px;padding:1.1rem .9rem;
  text-align:center;position:relative;overflow:hidden;
  cursor:pointer;transition:all .3s;
}
.stat:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.1)}
.stat::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.stat.s-a::before{background:var(--cat-a)}
.stat.s-b::before{background:var(--cat-b)}
.stat.s-ccr::before{background:var(--cat-ccr)}
.stat.s-cs::before{background:var(--cat-cs)}
.stat.s-d::before{background:var(--cat-d)}
.stat.s-e::before{background:var(--cat-e)}
.stat .s-num{font-family:var(--font-mono);font-size:1.8rem;font-weight:500;line-height:1}
.stat.s-a .s-num{color:var(--cat-a)}
.stat.s-b .s-num{color:var(--cat-b)}
.stat.s-ccr .s-num{color:var(--cat-ccr)}
.stat.s-cs .s-num{color:var(--cat-cs)}
.stat.s-d .s-num{color:var(--cat-d)}
.stat.s-e .s-num{color:var(--cat-e)}
.stat .s-pct{font-family:var(--font-mono);font-size:.7rem;color:var(--text-muted);margin-top:.15rem}
.stat .s-label{font-size:.72rem;color:var(--text-secondary);margin-top:.3rem;line-height:1.3}

/* ══ Suggest Form ══ */
.suggest-section{
  position:relative;z-index:1;
  max-width:720px;margin:0 auto;padding:4rem 2rem 2rem;
