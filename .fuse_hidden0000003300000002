{id:"C2",cat:"Ccr",source:"Olas (Valory)",sub:"",date:"2021-2025",def:"Agent economies where agents hire and sell services to each other, governed by on-chain DAO mechanisms.",notes:"Payment: crypto/tokens. Identity: on-chain wallets. Disputes: DAO governance. olas.network.",tags:["crypto","DAO","governance"]},
{id:"C3",cat:"Ccr",source:"Coinbase / Cloudflare",sub:"x402",date:"May 2025",def:"HTTP 402 status code + stablecoin micropayments. Account-less, subscription-free, pay-per-use.",notes:"Settlement in <500ms. Payment: USDC. Identity: account-less crypto. Disputes: none. x402.org.",tags:["x402","USDC","micropayments","HTTP 402"]},
{id:"C4",cat:"Ccr",source:"Circle",sub:"Nanopayments testnet",date:"Mar 2026",def:"Gas-free USDC transfers down to $0.000001. Off-chain aggregation, batched on-chain settlement.",notes:"Eliminates gas fees by batching. Payment: USDC, zero-gas. Identity: EVM wallet.",tags:["Circle","USDC","nanopayments"]},
{id:"C5",cat:"Ccr",source:"Kite",sub:"",date:"2026",def:"EVM-compatible Layer 1 specifically for agentic payments. \"Know Your Agent\" (KYA) framework with hierarchical on-chain identity.",notes:"Payment: stablecoin, zero-gas. Identity: KYA / \"Digital Agent Passport.\" Disputes: smart contract.",tags:["L1","KYA","identity"]},
{id:"C6",cat:"Ccr",source:"Gate Ventures",sub:"",date:"Dec 2025",def:"Four-layer Machine Economy framework: infrastructure, identity, economic, governance. Settlement via crypto/x402.",notes:"Payment: crypto/x402. Identity: ERC-8004. A VC framework, not a protocol -- but influential in shaping how the crypto ecosystem thinks about agent economics.",tags:["VC","framework","ERC-8004"]},
{id:"C7",cat:"Ccr",source:"Ken Huang & Lisa Tan",sub:"\"The AI Agent Economy\"",date:"Springer, Feb 2025",def:"Token economies incentivizing agent behavior. Virtuals, AI16z, and Token-of-Things as examples. Decentralized governance.",notes:"Academic treatment of crypto-native agent economics. Payment: crypto/tokens. Identity: decentralized.",tags:["academic","Springer","token economics"]},
{id:"C8",cat:"Ccr",source:"Xu et al.",sub:"\"The Agent Economy: A Blockchain-Based Foundation\"",date:"arXiv, Feb 2026",def:"Five-layer architecture: physical infrastructure (DePIN), identity (W3C DIDs), cognition (RAG + MCP), economic settlement (account abstraction), collective governance (DAOs).",notes:"The most architecturally complete proposal in Category C. Agents as \"sovereign economic peers.\" Payment: crypto. Identity: DIDs/wallets. Disputes: DAO.",tags:["academic","arXiv","five-layer","DIDs"]},
{id:"C9",cat:"Ccr",source:"Nevermined",sub:"",date:"2026",def:"\"Agentic Process Automation\" -- autonomous businesses with DID-based identity and crypto/fiat settlement.",notes:"Hybrid crypto/fiat but blockchain-first. Payment: crypto/fiat. Identity: DIDs.",tags:["DIDs","hybrid","automation"]},
{id:"C10",cat:"Ccr",source:"Bosch / IOTA / BearingPoint",sub:"",date:"2018-2025",def:"\"Machine Economy\" via IoT + distributed ledger technology. The historical precursor -- machines paying machines for data and services.",notes:"Legacy project. Payment: IOTA tokens. Identity: ledger IDs. Predates the LLM wave by years. The concept was right; the AI wasn't ready.",tags:["IoT","IOTA","precursor","legacy"]},
{id:"C11",cat:"Ccr",source:"OKX",sub:"OnchainOS",date:"2026",def:"Natural language commands routed to DeFi across 60+ chains. MCP integration for agent-to-DeFi interaction.",notes:"Payment: crypto/stablecoins. The agent speaks natural language; the infrastructure translates to on-chain transactions.",tags:["DeFi","MCP","multi-chain"]},
{id:"C12",cat:"Cs",source:"BotNode / VMP-1.0",sub:"Dechamps Otamendi",date:"Mar 2026",def:"Agents with own currency ($TCK), escrow-backed settlement, quantitative reputation (CRI 0-100), and automated dispute resolution. No blockchain.",notes:"agenticeconomy.dev. Payment: TCK (machine-native, closed-loop). Identity: API key + JWT. Disputes: deterministic rules + competitive verification markets. Settlement neutrality: MCP, A2A, and REST converge on the same escrow pipeline. The only non-crypto entry in Category C.",tags:["BotNode","TCK","escrow","CRI","settlement neutrality"]},
{id:"D1",cat:"D",source:"World Economic Forum",sub:"\"Trust Is the New Currency\"",date:"Jul 2025",def:"Three trust domains: human-to-human, human-to-agent, agent-to-agent. Trust is the fundamental constraint, not compute.",notes:"Also converges on Know Your Agent (KYA) as a cross-category identity framework. The WEF does not build infrastructure, but it shapes the regulatory conversation.",tags:["WEF","trust","KYA"]},
{id:"D2",cat:"D",source:"Bank of International Settlements",sub:"BIS",date:"2026",def:"\"Agentic Finance\" -- the Agentic Financial Market Model (AFMM). Four-layer architecture: perception, reasoning, strategy, execution.",notes:"Warns of algorithmic herding, automated bank runs, flash crashes. Engineering the \"Finternet\" -- interoperable network for programmable value systems.",tags:["BIS","central bank","Finternet"]},
{id:"D3",cat:"D",source:"a16z Crypto / YC / Medium",sub:"sovereign framing",date:"2025-2026",def:"Agents as sovereign actors. AI-native banks. Agents that own assets, sign contracts, and execute trades independently.",notes:"The VC framing that pushes Category C toward its most radical conclusion. Influential in shaping narrative, less in building infrastructure.",tags:["a16z","VC","sovereign"]},
{id:"D4",cat:"D",source:"Macroeconomic consensus",sub:"\"doom loop\"",date:"2026",def:"If Category B agents replace enough workers, wages collapse, consumer demand collapses. If demand collapses, the businesses that agents transact with have nothing to sell.",notes:"Convergent concern across multiple economic analyses. Suggests that non-extractive settlement designs may have structural advantages.",tags:["macro","doom loop","wages"]},
{id:"D5",cat:"D",source:"Antler VC",sub:"\"Unleashing the Autonomous Economy\"",date:"Jan 2026",def:"Frames the agent economy through Crossmint, Olas, and on-chain rails. Mentions ACK-ID, Nevermined ID.",notes:"Hybrid C/D. VC analysis that straddles building and analyzing. Primary framing is analytical.",tags:["Antler","VC","hybrid C/D"]},
{id:"D6",cat:"D",source:"Argoz Consultants",sub:"\"The Rise of the Machine Economy\"",date:"Mar 2026",def:"Machines negotiate, trade, and transact without human oversight.",notes:"Consultancy framing. Category C aspirational language wrapped in Category D analysis.",tags:["consultancy","analysis"]},
{id:"D7",cat:"D",source:"MIT Technology Review EmTech",sub:"\"The Dawn of the Agent Economy\"",date:"Nov 2025",def:"Trillions of AI agents as buyers, sellers, collaborators. NANDA building the \"DNS of the agentic web.\"",notes:"Visionary framing. The NANDA reference (agent naming/discovery) connects to Category E infrastructure.",tags:["MIT","NANDA","DNS"]},
{id:"E1",cat:"E",source:"Google",sub:"Agent-to-Agent Protocol (A2A)",date:"Apr 2025",def:"Agent discovery and communication. Agents publish Agent Cards at /.well-known/agent.json, exchange tasks via JSON-RPC over HTTPS.",notes:"v0.3. 150+ partners. Does not specify payment or settlement. The discovery layer for agents -- but without economics.",tags:["A2A","Google","JSON-RPC","discovery"]},
{id:"E2",cat:"E",source:"Anthropic",sub:"Model Context Protocol (MCP)",date:"2024",def:"A standard for LLMs to discover and invoke external tools. Focused on tool interoperability.",notes:"modelcontextprotocol.io. Does not specify payment, settlement, or reputation. The tool layer -- but without economics.",tags:["MCP","Anthropic","tools"]},
{id:"E3",cat:"E",source:"Trulioo / Worldpay / Skyfire",sub:"KYA Infrastructure",date:"2026",def:"\"Digital Agent Passport\" -- Know Your Agent identity verification for autonomous agents.",notes:"The KYC equivalent for machines. Cross-category: any category that needs to verify an agent's identity can use it.",tags:["KYA","identity","passport"]},
{id:"E4",cat:"E",source:"IEEE 7012",sub:"",date:"Draft, 2026",def:"Standard for terms and agreements between autonomous entities.",notes:"The first formal standards body to address agent-to-agent contracts. Still in draft. If ratified, it becomes the legal infrastructure for Category C.",tags:["IEEE","standard","contracts"]},
{id:"E5",cat:"E",source:"Forrester / Exista.io",sub:"Agent Discovery Optimization (ADO)",date:"2025-2026",def:"SEO is for humans. ADO is for agents. A brand invisible to agents is invisible to the agentic economy.",notes:"New concept. Implies that Category A and Category C will develop parallel discovery mechanisms.",tags:["ADO","discovery","SEO"]},
{id:"E6",cat:"E",source:"IETF",sub:"Verified Commerce for Agent Protocols (VCAP)",date:"Internet-Draft, 2026",def:"Cryptographic proof of work delivery for agent commerce. IETF standardization track.",notes:"Hybrid C/E. Addresses the verification problem at the protocol level. Complementary to escrow-based approaches.",tags:["IETF","VCAP","verification"]},
{id:"E7",cat:"E",source:"OECD",sub:"\"Agentic AI: Landscape and Conceptual Foundations\"",date:"2026",def:"Working paper on terminology and regulatory framing for agentic AI systems.",notes:"Hybrid D/E. The OECD defines terms and shapes regulatory vocabulary. What they name, legislators regulate.",tags:["OECD","regulatory","terminology"]},
{id:"E8",cat:"E",source:"a16z",sub:"Keycard investment",date:"Oct 2025",def:"The identity layer for the agent economy. Finding: non-human identities outnumber human employees 96-to-1 in finance.",notes:"The 96:1 ratio is striking -- finance already has more machine identities than human ones. Keycard builds the credential layer.",tags:["a16z","Keycard","identity","96:1"]},
{id:"E9",cat:"E",source:"Urbach et al.",sub:"\"Conceptualizing the Machine Economy\"",date:"PACIS 2021",def:"The complete integration and participation of economically autonomous acting machines in economic processes.",notes:"The earliest academic paper to formalize machine economic participation. Three prerequisites: autonomy, connectivity, intelligence. Predates the protocol wave by four years.",tags:["academic","PACIS","earliest","2021"]},
{id:"E10",cat:"E",source:"Goenka et al.",sub:"TessPay",date:"arXiv, Jan 2026",def:"Verify-then-Pay Infrastructure for Trusted Agentic Commerce. Escrow + TEE/TLS verification.",notes:"Hybrid C/E. Proves the seller delivered what the buyer paid for. Complementary to reputation systems.",tags:["TessPay","escrow","TEE","verification"]}
];

const CAT={
  A:{label:"Agent-Assisted Human Commerce",color:"var(--cat-a)",glow:"var(--cat-a-glow)",hex:"#3b82f6",n:"The agent buys for a human using human payment rails. The human is the economic actor."},
  B:{label:"Agent-as-Workforce",color:"var(--cat-b)",glow:"var(--cat-b-glow)",hex:"#a78bfa",n:"The agent replaces a human worker. The enterprise is the economic actor."},
  Ccr:{label:"Autonomous A2A Commerce (Blockchain)",color:"var(--cat-ccr)",glow:"var(--cat-ccr-glow)",hex:"#f59e0b",n:"The agent is the economic actor. Own wallet, own identity on-chain, transacts without human in the loop."},
  Cs:{label:"Autonomous A2A Commerce (Non-Crypto)",color:"var(--cat-cs)",glow:"var(--cat-cs-glow)",hex:"#34d399",n:"Agents transact autonomously without blockchain. Machine-native currency in a centralized double-entry ledger."},
  D:{label:"Analytical and Regulatory",color:"var(--cat-d)",glow:"var(--cat-d-glow)",hex:"#f87171",n:"They analyze what Categories A through C will do to markets, workers, and systemic stability."},
  E:{label:"Infrastructure and Standards",color:"var(--cat-e)",glow:"var(--cat-e-glow)",hex:"#22d3ee",n:"Horizontal layers: how agents find each other, verify identity, invoke tools, agree on terms."}
};
const CATS=["A","B","Ccr","Cs","D","E"];
const CAT_COUNTS={A:14,B:8,Ccr:11,Cs:1,D:7,E:10};

// ══ Particles ══
(function(){
  const c=document.getElementById('particles');
  const colors=["#3b82f6","#a78bfa","#f59e0b","#34d399","#f87171","#22d3ee"];
  for(let i=0;i<30;i++){
    const s=document.createElement('span');
    const size=Math.random()*3+1;
    s.style.cssText=`width:${size}px;height:${size}px;left:${Math.random()*100}%;background:${colors[i%6]};animation-duration:${Math.random()*20+15}s;animation-delay:${Math.random()*20}s;opacity:0;`;
    c.appendChild(s);
  }
})();

// ══ Hero count animation ══
(function(){
  const el=document.getElementById('hero-count');
  let n=0;const target=51;const step=Math.ceil(target/30);
  const iv=setInterval(()=>{n=Math.min(n+step,target);el.textContent=n;if(n>=target)clearInterval(iv)},40);
})();

// ══ Distribution bar ══
(function(){
  const bar=document.getElementById('distro-bar');
  const labels=document.getElementById('distro-labels');
  CATS.forEach(c=>{
    const pct=(CAT_COUNTS[c]/51*100);
    const seg=document.createElement('div');
    seg.className='seg';
    seg.style.cssText=`width:${pct}%;background:${CAT[c].hex};`;
    seg.dataset.cat=c;
    seg.addEventListener('click',()=>setFilter(c));
    bar.appendChild(seg);
    const dl=document.createElement('div');
    dl.className='dl';
    dl.innerHTML=`<span class="swatch" style="background:${CAT[c].hex}"></span>${c==='Ccr'?'C<sub>cr</sub>':c==='Cs'?'C<sub>s</sub>':c} ${CAT_COUNTS[c]}`;
    dl.addEventListener('click',()=>setFilter(c));
    labels.appendChild(dl);
  });
})();

// ══ Sticky controls shadow ══
window.addEventListener('scroll',()=>{
  document.getElementById('controls').classList.toggle('scrolled',window.scrollY>200);
},{passive:true});

// ══ Render ══
let activeFilter='all';
let currentModalIdx=-1;
let visibleDefs=[];

function getFiltered(filter,query){
  return DEFS.filter(d=>{
    if(filter!=='all'&&d.cat!==filter)return false;
    if(query){
      const q=query.toLowerCase();
      const h=(d.id+' '+d.source+' '+(d.sub||'')+' '+d.def+' '+d.notes+' '+(d.tags||[]).join(' ')).toLowerCase();
      if(!h.includes(q))return false;
    }
    return true;
  });
}

function renderGrid(){
  const query=document.getElementById('search').value;
  const grid=document.getElementById('grid');
  visibleDefs=getFiltered(activeFilter,query);
  grid.innerHTML='';

  if(visibleDefs.length===0){
    grid.innerHTML='<div class="no-results"><div class="nr-icon">&#128270;</div>No definitions match your search.</div>';
    document.getElementById('result-count').textContent='0 definitions';
    return;
  }

  document.getElementById('result-count').textContent=visibleDefs.length+' definition'+(visibleDefs.length!==1?'s':'');

  // Group by category
  CATS.forEach(cat=>{
    const entries=visibleDefs.filter(d=>d.cat===cat);
    if(!entries.length)return;
    const meta=CAT[cat];
    const section=document.createElement('div');
    section.className='category-section';

    const catLabel=cat==='Ccr'?'C<sub>cr</sub>':cat==='Cs'?'C<sub>s</sub>':cat;

    section.innerHTML=`
      <div class="category-header">
        <span class="cat-line" style="background:${meta.hex}">${catLabel}</span>
        <h2>${meta.label}</h2>
        <span class="cat-count">${entries.length}</span>
      </div>
      <p class="category-narrative">${meta.n}</p>
      <div class="cards-grid"></div>
    `;
    grid.appendChild(section);

    const cg=section.querySelector('.cards-grid');
    entries.forEach((d,i)=>{
      const card=document.createElement('div');
      card.className='card';
      card.dataset.cat=d.cat;
      card.style.animationDelay=(i*0.04)+'s';
      card.innerHTML=`
        <div class="c-top"><span class="c-id">${d.id}</span><span class="c-date">${d.date}</span></div>
        <div class="c-source">${d.source}</div>
        ${d.sub?'<div class="c-sub">'+d.sub+'</div>':''}
        <div class="c-def">${d.def}</div>
        <div class="c-expand"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg> Read full definition</div>
      `;
      card.addEventListener('click',()=>{
        currentModalIdx=visibleDefs.indexOf(d);
        openModal(d);
      });
      cg.appendChild(card);
    });
  });
}

// ══ Modal ══
function openModal(d){
  const meta=CAT[d.cat];
  const catLabel=d.cat==='Ccr'?'C<sub>cr</sub>':d.cat==='Cs'?'C<sub>s</sub>':d.cat;
  const content=document.getElementById('modal-content');
  content.innerHTML=`
    <span class="m-badge" style="background:${meta.hex}">${catLabel} &mdash; ${meta.label}</span>
    <div class="m-id">${d.id}</div>
    <div class="m-source">${d.source}</div>
    ${d.sub?'<div class="m-sub">'+d.sub+'</div>':''}
    <div class="m-date">${d.date}</div>
    <div class="m-definition cat-${d.cat}">${d.def}</div>
    <div class="m-notes">${d.notes}</div>
    <div class="m-tags">${(d.tags||[]).map(t=>'<span>'+t+'</span>').join('')}</div>
    <div class="m-nav">
      <button id="m-prev" ${currentModalIdx<=0?'disabled':''}><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg> Prev</button>
      <button id="m-next" ${currentModalIdx>=visibleDefs.length-1?'disabled':''}> Next <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
    </div>
  `;
  document.getElementById('m-prev').addEventListener('click',e=>{e.stopPropagation();if(currentModalIdx>0){currentModalIdx--;openModal(visibleDefs[currentModalIdx])}});
  document.getElementById('m-next').addEventListener('click',e=>{e.stopPropagation();if(currentModalIdx<visibleDefs.length-1){currentModalIdx++;openModal(visibleDefs[currentModalIdx])}});

  document.getElementById('modal-overlay').classList.add('open');
  document.body.style.overflow='hidden';
}

function closeModal(){
  document.getElementById('modal-overlay').classList.remove('open');
  document.body.style.overflow='';
}
document.getElementById('modal-close').addEventListener('click',closeModal);
document.getElementById('modal-overlay').addEventListener('click',e=>{if(e.target===e.currentTarget)closeModal()});
document.addEventListener('keydown',e=>{
  if(e.key==='Escape')closeModal();
  if(document.getElementById('modal-overlay').classList.contains('open')){
    if(e.key==='ArrowLeft'&&currentModalIdx>0){currentModalIdx--;openModal(visibleDefs[currentModalIdx])}
    if(e.key==='ArrowRight'&&currentModalIdx<visibleDefs.length-1){currentModalIdx++;openModal(visibleDefs[currentModalIdx])}
  }
});

// ══ Filters ══
function setFilter(cat){
  activeFilter=cat;
  document.querySelectorAll('.pill').forEach(p=>p.classList.remove('active'));
  document.querySelector(`.pill[data-cat="${cat}"]`).classList.add('active');
  renderGrid();
}
document.querySelectorAll('.pill').forEach(pill=>{
  pill.addEventListener('click',()=>setFilter(pill.dataset.cat));
});

// ══ Stat cards clickable ══
document.querySelectorAll('.stat[data-filter]').forEach(s=>{
  s.addEventListener('click',()=>setFilter(s.dataset.filter));
});

// ══ Search ══
let searchTimeout;
document.getElementById('search').addEventListener('input',e=>{
  clearTimeout(searchTimeout);
  searchTimeout=setTimeout(renderGrid,120);
});

// ══ Suggest form ══
document.getElementById('suggest-btn').addEventListener('click',()=>{
  const source=document.getElementById('f-source').value.trim();
  const date=document.getElementById('f-date').value.trim();
  const url=document.getElementById('f-url').value.trim();
  const def=document.getElementById('f-def').value.trim();
  const cat=document.getElementById('f-cat').value;
  const name=document.getElementById('f-name').value.trim();
  const why=document.getElementById('f-why').value.trim();

  if(!source||!date||!url||!def){
    alert('Please fill in all required fields (Source, Date, URL, Definition).');
    return;
  }

  const catLabel=cat?document.getElementById('f-cat').options[document.getElementById('f-cat').selectedIndex].text:'Not specified';

  const subject=encodeURIComponent('Corpus submission: '+source+' ('+date+')');
  const body=encodeURIComponent(
    'NEW DEFINITION SUBMISSION\n'+
    '========================\n\n'+
    'Source: '+source+'\n'+
    'Date: '+date+'\n'+
    'URL: '+url+'\n'+
    'Category: '+catLabel+'\n'+
    (name?'Submitted by: '+name+'\n':'')+
    '\nDefinition:\n'+def+'\n'+
    (why?'\nWhy it qualifies:\n'+why+'\n':'')+
    '\n---\nSubmitted via agenticeconomy.dev/corpus'
  );

  window.location.href='mailto:rene@renedechamps.com?subject='+subject+'&body='+body;
});

// ══ Init ══
renderGrid();

// Nav toggle (mobile)
document.querySelector('.nav-toggle').addEventListener('click', () => {
  document.querySelector('.nav-menu').classList.toggle('open');
});
// Dropdown toggle (mobile)
document.querySelectorAll('.nav-dropdown-trigger').forEach(btn => {
  btn.addEventListener('click', (e) => {
    if (window.innerWidth <= 768) {
      e.preventDefault();
      btn.closest('.nav-dropdown').classList.toggle('open');
    }
  });
});
// Highlight current page
const currentPage = location.pathname.split('/').pop() || 'agentic-economy-101.html';
document.querySelectorAll('.site-nav a[href]').forEach(a => {
  if (a.getAttribute('href') === currentPage) a.classList.add('active');
});
// Close dropdowns when clicking outside
document.addEventListener('click', (e) => {
  if (!e.target.closest('.nav-dropdown')) {
    document.querySelectorAll('.nav-dropdown.open').forEach(d => d.classList.remove('open'));
  }
});
</script>
