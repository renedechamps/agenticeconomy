<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Which Economy Is Your Agent In?</title>

    <!-- Font Imports -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Outfit:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-deep: #04060e;
            --bg-base: #080d1c;
            --bg-surface: #0f1530;
            --bg-card: #141a38;
            --border: #1a2348;
            --text-primary: #e8ecf4;
            --text-secondary: #a0a9c0;
            --text-muted: #6b7394;
            --accent: #34d399;
            --warm: #f59e0b;
            --cat-a: #3b82f6;
            --cat-b: #a78bfa;
            --cat-ccr: #f59e0b;
            --cat-cs: #34d399;
            --cat-d: #f87171;
            --cat-e: #22d3ee;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg-deep);
            color: var(--text-primary);
            font-family: 'Outfit', sans-serif;
            font-weight: 400;
            line-height: 1.6;
            overflow-x: hidden;
            padding-top: 56px;
        }

        /* ── Site Navigation ── */
        .site-nav{position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(4,6,14,.97);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--border);height:56px;display:flex;align-items:center;padding:0 2rem}
        .nav-container{max-width:1200px;margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between}
        .nav-brand{font-family:'Syne',sans-serif;font-weight:700;font-size:1.05rem;color:var(--accent);text-decoration:none;letter-spacing:-.02em}
        .nav-menu{display:flex;align-items:center;gap:.25rem}
        .nav-item{color:var(--text-secondary);text-decoration:none;font-family:'Outfit',sans-serif;font-size:.88rem;padding:.45rem .75rem;border-radius:6px;transition:color .2s,background .2s;border:none;background:none;cursor:pointer;white-space:nowrap}
        .nav-item:hover,.nav-item.active{color:var(--text-primary);background:var(--bg-surface)}
        .nav-dropdown{position:relative}
        .nav-dropdown-trigger{display:flex;align-items:center;gap:.3rem}
        .arrow{font-size:.6rem;transition:transform .2s}
        .nav-dropdown:hover .arrow{transform:rotate(180deg)}
        .dropdown-panel{display:none;position:absolute;top:calc(100% + 4px);left:0;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:.4rem 0;min-width:180px;box-shadow:0 12px 40px rgba(0,0,0,.5)}
        .nav-dropdown:hover .dropdown-panel{display:block}
        .dropdown-panel a{display:block;padding:.5rem 1rem;color:var(--text-secondary);text-decoration:none;font-family:'Outfit',sans-serif;font-size:.85rem;transition:color .15s,background .15s,padding-left .15s}
        .dropdown-panel a:hover{color:var(--accent);background:var(--bg-surface);padding-left:1.25rem}
        .nav-toggle{display:none;background:none;border:none;color:var(--text-primary);font-size:1.4rem;cursor:pointer;padding:.5rem}
        @media(max-width:768px){
          .nav-toggle{display:block}
          .nav-menu{display:none;position:absolute;top:56px;left:0;right:0;background:var(--bg-card);border-bottom:1px solid var(--border);flex-direction:column;padding:1rem;gap:.15rem}
          .nav-menu.open{display:flex}
          .dropdown-panel{position:static;box-shadow:none;border:none;background:var(--bg-surface);border-radius:6px;margin:.25rem 0 .25rem 1rem;display:none}
          .nav-dropdown.open .dropdown-panel{display:block}
        }

        /* Main content */
        main {
            margin-top: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4rem 2rem;
        }

        .quiz-container {
            max-width: 600px;
            width: 100%;
        }

        /* Progress bar */
        .progress-container {
            margin-bottom: 3rem;
        }

        .progress-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .progress-bar {
            height: 4px;
            background: var(--bg-card);
            border-radius: 2px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--cat-a) 0%, var(--cat-b) 50%, var(--cat-ccr) 100%);
            transition: width 0.5s ease;
        }

        /* Question section */
        .question-section {
            animation: fadeInQuestion 0.5s ease;
        }

        @keyframes fadeInQuestion {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .question-text {
            font-family: 'Syne', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 2rem;
            line-height: 1.3;
        }

        .answers-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .answer-card {
            padding: 1.5rem;
            background: var(--bg-card);
            border: 2px solid var(--border);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: left;
            min-height: 80px;
            display: flex;
            align-items: center;
        }

        .answer-card:hover {
            border-color: var(--text-secondary);
            background: var(--bg-surface);
            transform: translateX(4px);
        }

        .answer-card.selected {
            border-color: var(--text-primary);
            background: var(--bg-surface);
        }

        /* Category-specific styling */
        .answer-card.cat-a.selected {
            border-color: var(--cat-a);
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
        }

        .answer-card.cat-b.selected {
            border-color: var(--cat-b);
            box-shadow: 0 0 20px rgba(167, 139, 250, 0.3);
        }

        .answer-card.cat-ccr.selected {
            border-color: var(--cat-ccr);
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
        }

        .answer-card.cat-cs.selected {
            border-color: var(--cat-cs);
            box-shadow: 0 0 20px rgba(52, 211, 153, 0.3);
        }

        .answer-card.cat-d.selected {
            border-color: var(--cat-d);
            box-shadow: 0 0 20px rgba(248, 113, 113, 0.3);
        }

        .answer-card.cat-e.selected {
            border-color: var(--cat-e);
            box-shadow: 0 0 20px rgba(34, 211, 238, 0.3);
        }

        .answer-text {
            font-size: 1rem;
            color: var(--text-primary);
            font-weight: 500;
        }

        .answer-card:hover .answer-text {
            color: var(--accent);
        }

        /* Results section */
        .results-section {
            animation: fadeInResults 0.6s ease;
        }

        @keyframes fadeInResults {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .result-card {
            border-radius: 16px;
            padding: 3rem;
            margin-bottom: 2rem;
            border: 2px solid var(--border);
            position: relative;
            overflow: hidden;
        }

        .result-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
        }

        .result-card.cat-a::before { background: var(--cat-a); }
        .result-card.cat-b::before { background: var(--cat-b); }
        .result-card.cat-ccr::before { background: var(--cat-ccr); }
        .result-card.cat-cs::before { background: var(--cat-cs); }
        .result-card.cat-d::before { background: var(--cat-d); }
        .result-card.cat-e::before { background: var(--cat-e); }

        .result-header {
            display: flex;
            align-items: baseline;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .result-letter {
            font-family: 'Syne', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            min-width: 60px;
        }

        .result-letter.cat-a { color: var(--cat-a); }
        .result-letter.cat-b { color: var(--cat-b); }
        .result-letter.cat-ccr { color: var(--cat-ccr); }
        .result-letter.cat-cs { color: var(--cat-cs); }
        .result-letter.cat-d { color: var(--cat-d); }
        .result-letter.cat-e { color: var(--cat-e); }

        .result-name {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
        }

        .result-description {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: 2rem;
            line-height: 1.8;
        }

        .result-companies {
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--border);
        }

        .result-companies-label {
            font-family: 'Syne', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .result-companies-list {
            font-size: 0.95rem;
            color: var(--text-secondary);
            line-height: 1.8;
        }

        .result-stat {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
            font-family: 'JetBrains Mono', monospace;
        }

        .result-cta {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .result-btn {
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--bg-surface);
            color: var(--text-primary);
            text-decoration: none;
            text-align: center;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .result-btn:hover {
            border-color: var(--accent);
            background: var(--bg-card);
            transform: translateY(-2px);
        }

        .result-btn.primary {
            background: var(--bg-card);
            border-color: var(--accent);
            color: var(--accent);
        }

        .result-btn.primary:hover {
            background: rgba(52, 211, 153, 0.1);
        }

        /* Retake button */
        .retake-section {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .retake-btn {
            flex: 1;
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--bg-surface);
            color: var(--text-secondary);
            text-decoration: none;
            text-align: center;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .retake-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        /* Confetti animation */
        @keyframes confetti-fall {
            to {
                transform: translateY(100vh) rotate(360deg);
                opacity: 0;
            }
        }

        .confetti {
            position: fixed;
            pointer-events: none;
            animation: confetti-fall 2.5s ease-out forwards;
        }

        /* Footer */
        footer {
            background: var(--bg-base);
            border-top: 1px solid var(--border);
            padding: 2rem 4rem;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 4rem;
        }

        footer a {
            color: var(--accent);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        footer a:hover {
            color: var(--text-primary);
        }

        /* Responsive */
        @media (max-width: 768px) {
            nav {
                padding: 0 1.5rem;
            }

            nav .nav-left {
                font-size: 1rem;
            }

            nav .nav-right {
                gap: 1rem;
                font-size: 0.85rem;
            }

            nav a {
                font-size: 0.8rem;
            }

            main {
                padding: 2rem 1rem;
            }

            .question-text {
                font-size: 1.4rem;
            }

            .answer-card {
                min-height: 70px;
                padding: 1.25rem;
            }

            .answer-text {
                font-size: 0.95rem;
            }

            .result-card {
                padding: 2rem;
            }

            .result-header {
                flex-direction: column;
                gap: 0.5rem;
            }

            .result-letter {
                font-size: 2rem;
            }

            .result-name {
                font-size: 1.4rem;
            }

            footer {
                padding: 2rem 1.5rem;
            }
        }

        /* Hide/show utilities */
        .hidden {
            display: none;
        }
    </style>
</head>
