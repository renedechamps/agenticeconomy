    <!-- Footer -->
    <footer>
        <p>
            Read the research: <a href="https://zenodo.org/records/19208278" target="_blank" rel="noopener">zenodo.org/records/19208278</a>
            <br>
            Learn more: <a href="https://agenticeconomy.dev" target="_blank" rel="noopener">agenticeconomy.dev</a>
        </p>
