    <script>
        // Quiz data structure
        const quizData = [
            {
                question: "What does your agent DO?",
                answers: [
                    { text: "Buys products or services for a human user", points: { A: 3 } },
                    { text: "Performs tasks inside a company (filing, coding, compliance)", points: { B: 3 } },
                    { text: "Transacts directly with other agents", points: { C: 3 } },
                    { text: "Analyzes markets or regulatory risks", points: { D: 3 } }
                ]
            },
            {
                question: "Who controls the wallet / payment method?",
                answers: [
                    { text: "The human user (credit card, bank account, OAuth)", points: { A: 3 } },
                    { text: "The enterprise (budget allocation, SLA-based)", points: { B: 2, A: 1 } },
                    { text: "The agent itself (crypto wallet, own currency)", points: { C: 3 } },
                    { text: "No payment involved", points: { E: 2, D: 1 } }
                ]
            },
            {
                question: "Does your agent need blockchain?",
                answers: [
                    { text: "No — fiat rails, credit cards, bank transfers", points: { A: 2 } },
                    { text: "Yes — crypto wallets, stablecoins, smart contracts", points: { Ccr: 3 } },
                    { text: "No, but it needs its own non-fiat currency", points: { Cs: 3 } },
                    { text: "Not applicable — it's infrastructure", points: { E: 2 } }
                ]
            },
            {
                question: "How are disputes resolved?",
                answers: [
                    { text: "Chargebacks / existing consumer protection", points: { A: 2 } },
                    { text: "SLAs and enterprise contracts", points: { B: 2 } },
                    { text: "Smart contract escrow / DAO governance", points: { Ccr: 3 } },
                    { text: "Deterministic rules / automated validators", points: { Cs: 3 } },
                    { text: "Not applicable", points: { E: 1 } }
                ]
            },
            {
                question: "Who is the economic actor?",
                answers: [
                    { text: "The human — the agent is a tool", points: { A: 3 } },
                    { text: "The company — the agent is an employee", points: { B: 3 } },
                    { text: "The agent itself — it's a sovereign participant", points: { Ccr: 2, Cs: 1 } },
                    { text: "Nobody — we're analyzing, not building", points: { D: 3 } }
                ]
            },
            {
                question: "What's your agent's identity?",
                answers: [
                    { text: "Delegated from the human (OAuth, passkeys)", points: { A: 2 } },
                    { text: "Enterprise SSO / API key", points: { B: 2, E: 1 } },
                    { text: "On-chain wallet / DID", points: { Ccr: 3 } },
                    { text: "API key + JWT / protocol-agnostic", points: { Cs: 2, E: 1 } },
                    { text: "Agent Card (A2A) / tool manifest (MCP)", points: { E: 3 } }
                ]
            },
            {
                question: "What's your primary concern?",
                answers: [
                    { text: "Consumer experience and checkout conversion", points: { A: 2 } },
                    { text: "Enterprise ROI and operational efficiency", points: { B: 2 } },
                    { text: "Agent autonomy and decentralized governance", points: { Ccr: 2 } },
                    { text: "Regulatory compliance and risk", points: { D: 2 } },
                    { text: "Interoperability and standards", points: { E: 2 } }
                ]
            }
        ];

        // Category definitions and info
        const categoryInfo = {
            A: {
                name: "Agent-Assisted Commerce",
                letter: "A",
                description: "Your agent helps humans make purchasing decisions and complete transactions. The human retains control of the wallet and payment method. Think of agents that shop for you, compare prices, and check out using your credentials.",
                companies: ["Stripe ACP", "Visa", "Mastercard", "PayPal"],
                stat: "14 of 51 definitions",
                corpus_query: "A"
            },
            B: {
                name: "Agent-as-Workforce",
                letter: "B",
                description: "Your agent replaces or augments human workers inside an organization. It's an employee or contractor that handles internal workflows, compliance tasks, and decision-making within enterprise guardrails.",
                companies: ["Gartner (100M agents by 2028)", "IBM", "OpenAI"],
                stat: "8 of 51 definitions",
                corpus_query: "B"
            },
            Ccr: {
                name: "Autonomous A2A (Blockchain)",
                letter: "C_cr",
                description: "Your agent transacts directly with other agents using blockchain. Agents hold their own crypto wallets, negotiate with each other, and settle on-chain. Smart contracts and DAOs arbitrate disputes.",
                companies: ["x402", "Olas", "Fetch.ai", "Coinbase"],
                stat: "11 of 51 definitions",
                corpus_query: "Ccr"
            },
            Cs: {
                name: "Autonomous A2A (Non-Crypto)",
                letter: "C_s",
                description: "Your agent transacts autonomously with other agents without using blockchain. It uses deterministic rules, protocol-agnostic identity, and machine-native currencies for settlement and dispute resolution.",
                companies: ["BotNode VMP-1.0"],
                stat: "1 of 51 definitions",
                corpus_query: "Cs"
            },
            D: {
                name: "Analytical & Regulatory",
                letter: "D",
                description: "You're analyzing the agentic economy rather than building in it. You work on policy, risk assessment, compliance frameworks, and the societal implications of autonomous agents.",
                companies: ["BIS", "WEF", "OECD", "Deloitte"],
                stat: "7 of 51 definitions",
                corpus_query: "D"
            },
            E: {
                name: "Infrastructure & Standards",
                letter: "E",
                description: "You're building the foundational pipes that other agents and economies depend on. You work on protocols, standards, APIs, and interoperability layers that multiple economies will use.",
                companies: ["Google A2A", "Anthropic MCP", "Cloudflare", "IEEE"],
                stat: "10 of 51 definitions",
                corpus_query: "E"
            }
        };

        // State
        let currentQuestion = 0;
        let scores = { A: 0, B: 0, Ccr: 0, Cs: 0, D: 0, E: 0 };
        let answered = false;

        // Initialize quiz
        function initQuiz() {
            renderQuestion();
        }

        // Render current question
        function renderQuestion() {
            const question = quizData[currentQuestion];
            const quizContent = document.getElementById('quiz-content');
            const progress = ((currentQuestion + 1) / quizData.length) * 100;

            document.getElementById('current-question').textContent = currentQuestion + 1;
            document.getElementById('progress-fill').style.width = progress + '%';

            const answersHTML = question.answers.map((answer, idx) => {
                const category = Object.keys(answer.points)[0];
                return `
                    <div class="answer-card cat-${category}" data-index="${idx}" onclick="selectAnswer(${idx})">
                        <div class="answer-text">${answer.text}</div>
                    </div>
                `;
            }).join('');

            quizContent.innerHTML = `
                <div class="question-section">
                    <div class="question-text">${question.question}</div>
                    <div class="answers-grid">
                        ${answersHTML}
                    </div>
                </div>
            `;

            answered = false;
        }

        // Handle answer selection
        function selectAnswer(index) {
            if (answered) return;
            answered = true;

            const question = quizData[currentQuestion];
            const answer = question.answers[index];

            // Add points
            Object.keys(answer.points).forEach(category => {
                scores[category] += answer.points[category];
            });

            // Mark as selected
            const cards = document.querySelectorAll('.answer-card');
            cards[index].classList.add('selected');

            // Move to next question or show results
            setTimeout(() => {
                if (currentQuestion < quizData.length - 1) {
                    currentQuestion++;
                    renderQuestion();
                } else {
                    showResults();
                }
            }, 500);
        }

        // Show results
        function showResults() {
            // Calculate winner
            let winner = null;
            let maxScore = 0;

            const categoryPriority = ['Cs', 'Ccr', 'C', 'A', 'B', 'D', 'E']; // More specific wins ties

            for (const category in scores) {
                if (scores[category] > maxScore) {
                    maxScore = scores[category];
                    winner = category;
                } else if (scores[category] === maxScore && winner) {
                    // Apply tiebreaker
                    const winnerPriority = categoryPriority.indexOf(winner);
                    const candidatePriority = categoryPriority.indexOf(category);
                    if (candidatePriority < winnerPriority && candidatePriority !== -1) {
                        winner = category;
                    }
                }
            }

            const info = categoryInfo[winner];
            const resultURL = `agentic-economy-definitions.html?filter=${info.corpus_query}`;
            const shareText = `My AI agent is in Category ${info.letter} (${info.name}) of the Agentic Economy. Find yours: https://agenticeconomy.dev/agentic-economy-quiz.html via @agenticeconomy`;

            const resultsSection = document.getElementById('results-section');
            resultsSection.innerHTML = `
                <div class="result-card cat-${winner}">
                    <div class="result-header">
                        <div class="result-letter cat-${winner}">${info.letter}</div>
                        <div>
                            <div class="result-name">${info.name}</div>
                        </div>
                    </div>

                    <div class="result-description">${info.description}</div>

                    <div class="result-companies">
                        <div class="result-companies-label">You're in good company:</div>
                        <div class="result-companies-list">${info.companies.join(' • ')}</div>
                    </div>

                    <div class="result-stat">${info.stat} in this category</div>

                    <div class="result-cta">
                        <a href="${resultURL}" class="result-btn primary">Explore all Category ${info.letter} definitions →</a>
                        <button class="result-btn" onclick="copyToClipboard('${shareText}')">Share your result</button>
                    </div>
                </div>

                <div class="retake-section">
                    <button class="retake-btn" onclick="retakeQuiz()">Retake Quiz</button>
                </div>
            `;

            document.getElementById('quiz-title').classList.add('hidden');
            document.getElementById('progress-container')?.classList.add('hidden');
            document.getElementById('quiz-content').classList.add('hidden');
            resultsSection.classList.remove('hidden');

            // Trigger confetti
            createConfetti();
        }

        // Confetti animation
        function createConfetti() {
            const confettiPieces = 30;
            const colors = ['#3b82f6', '#a78bfa', '#f59e0b', '#34d399', '#f87171', '#22d3ee'];

            for (let i = 0; i < confettiPieces; i++) {
                const confetti = document.createElement('div');
                confetti.className = 'confetti';
                confetti.style.left = Math.random() * 100 + '%';
                confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                confetti.style.width = Math.random() * 10 + 5 + 'px';
                confetti.style.height = confetti.style.width;
                confetti.style.borderRadius = '50%';
                confetti.style.opacity = Math.random() * 0.7 + 0.3;
                confetti.style.animation = `confetti-fall ${Math.random() * 1.5 + 2}s ease-out forwards`;
                document.body.appendChild(confetti);

                setTimeout(() => confetti.remove(), 3000);
            }
        }

        // Copy to clipboard
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                alert('Copied to clipboard!');
            });
        }

        // Retake quiz
        function retakeQuiz() {
            currentQuestion = 0;
            scores = { A: 0, B: 0, Ccr: 0, Cs: 0, D: 0, E: 0 };
            answered = false;

            document.getElementById('quiz-title').classList.remove('hidden');
            document.getElementById('quiz-content').classList.remove('hidden');
            document.getElementById('results-section').classList.add('hidden');

            renderQuestion();
        }

        // Start quiz on load
        window.addEventListener('load', initQuiz);

        // Nav toggle (mobile)
        document.querySelector('.nav-toggle').addEventListener('click', () => {
          document.querySelector('.nav-menu').classList.toggle('open');
        });
        // Dropdown toggle (mobile)
        document.querySelectorAll('.nav-dropdown-trigger').forEach(btn => {
          btn.addEventListener('click', (e) => {
            if (window.innerWidth <= 768) {
              e.preventDefault();
              btn.closest('.nav-dropdown').classList.toggle('open');
            }
          });
        });
        // Highlight current page
        const currentPage = location.pathname.split('/').pop() || 'agentic-economy-101.html';
        document.querySelectorAll('.site-nav a[href]').forEach(a => {
          if (a.getAttribute('href') === currentPage) a.classList.add('active');
        });
        // Close dropdowns when clicking outside
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.nav-dropdown')) {
            document.querySelectorAll('.nav-dropdown.open').forEach(d => d.classList.remove('open'));
          }
        });
    </script>
</body>
</html>
