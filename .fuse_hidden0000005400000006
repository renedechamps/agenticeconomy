    <main>
        <div class="quiz-container">
            <!-- Quiz Title -->
            <div id="quiz-title" style="margin-bottom: 3rem;">
                <h1 style="font-family: 'Syne', sans-serif; font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; line-height: 1.2;">Which Economy Is Your Agent In?</h1>
                <p style="font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 0;">Take a 7-question quiz to find your category in the Agentic Economy.</p>
            </div>

            <!-- Progress bar -->
            <div class="progress-container">
                <div class="progress-label">Question <span id="current-question">1</span> of 7</div>
                <div class="progress-bar">
                    <div class="progress-fill" id="progress-fill" style="width: 0%;"></div>
                </div>
            </div>

            <!-- Quiz content -->
            <div id="quiz-content">
                <!-- Questions will be inserted here -->
            </div>

            <!-- Results -->
            <div id="results-section" class="hidden results-section">
                <!-- Results will be inserted here -->
            </div>
        </div>
